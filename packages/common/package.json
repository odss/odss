{
  "name": "@odss/common",
  "version": "1.0.0",
  "description": "ODSS Common",
  "license": "MIT",
  "source": "src/index.ts",
  "main": "dist/common.js",
  "module": "dist/common.mjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "browser": "./dist/common.mjs",
      "import": "./dist/common.mjs",
      "require": "./dist/common.js"
    }
  },
  "scripts": {
    "build": "micropack --include reflect-metadata/lite",
    "build:dev": "npm run build -- --dev",
    "lint": "eslint src/*",
    "format": "prettier src/ tests/ --write",
    "prepare": "npm run build"
  },
  "dependencies": {
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@stool/micropack": "0.8.3",
    "prettier": "3.6.2",
    "typescript": "^5.9.3"
  },
  "files": [
    "README.md",
    "dist/*.*",
    "dist/**/*.d.ts"
  ]
}
