{
  "name": "@odss/core",
  "version": "1.0.0",
  "description": "Odss Core",
  "license": "MIT",
  "source": "src/index.ts",
  "main": "./dist/odss.core.js",
  "module": "./dist/odss.core.mjs",
  "types": "dist/types/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "browser": "./dist/odss.core.mjs",
      "import": "./dist/odss.core.mjs",
      "require": "./dist/odss.core.js"
    }
  },
  "scripts": {
    "build": "micropack --include @odss/query",
    "build:dev": "micropack --include @odss/query --dev",
    "lint": "eslint src/*",
    "format": "prettier src/ tests/ --write",
    "test": "vitest run",
    "test:dev": "vitest",
    "test:cov": "vitest run --coverage",
    "test:cov:html": "vitest run --coverage --reporter text-summary --reporter html",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@odss/common": "1.0.0",
    "@odss/query": "1.0.0",
    "@stool/logging": "^3.2.2"
  },
  "devDependencies": {
    "@stool/micropack": "0.6.0",
    "@types/chai": "4.3.4",
    "@types/node": "18.15.1",
    "@typescript-eslint/eslint-plugin": "5.54.1",
    "@vitest/coverage-v8": "^1.6.0",
    "chai": "^4.3.7",
    "eslint": "8.36.0",
    "jsdom": "^23.0.0",
    "prettier": "2.8.4",
    "sinon": "15.0.2",
    "typescript": "4.9.5",
    "vite": "^5.0.0",
    "vitest": "^1.6.0"
  },
  "files": [
    "README.md",
    "dist/*.*",
    "dist/types/*.d.ts"
  ]
}
